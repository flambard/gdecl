# Make rules for building a gdecl application. Include this file from the
# application's Makefile, after setting:
#
#   SYSTEM     The application's ASDF system (required)
#   LISP_DIRS  Directories with the application's .asd and .lisp files
#              (default: lisp)
#   GODOT      The Godot executable (default: godot)
#
# Targets: all (the default), application.a, godot-api and clean.

# The directory of this file, so gdecl can be anywhere
GDECL := $(patsubst %/,%,$(dir $(lastword $(MAKEFILE_LIST))))

LISP_DIRS ?= lisp
GODOT ?= godot

ifndef SYSTEM
$(error Set SYSTEM to the application's ASDF system before including gdecl.mk)
endif

GDECL_API_FILES = $(GDECL)/src/gdextension_interface.h $(GDECL)/extension_api.json

all: application.a $(GDECL_API_FILES)

# Always application.a with the init function init_lib_APPLICATION, whatever
# SYSTEM is, so gdecl/src/gdecl.c doesn't depend on the application.
# :monolithic t includes the systems SYSTEM depends on (gdecl); the output is
# then named SYSTEM--all-systems.a. Changing SYSTEM doesn't make application.a
# out of date, so use make -B SYSTEM=...
application.a: $(wildcard $(GDECL)/*.asd $(GDECL)/lisp/*.lisp $(foreach dir,$(LISP_DIRS),$(dir)/*.asd $(dir)/*.lisp))
	ecl -norc \
	    -eval '(require :asdf)' \
	    $(foreach dir,$(GDECL) $(LISP_DIRS),-eval '(push "$(dir)/" asdf:*central-registry*)') \
	    -eval '(asdf:make-build :$(SYSTEM) :type :static-library :monolithic t :move-here "./" :init-name "init_lib_APPLICATION")' \
	    -eval '(quit)'
	mv $(SYSTEM)--all-systems.a application.a

# Generated by Godot into the working directory. Only made when missing; run
# `make godot-api` to regenerate them, e.g. after upgrading Godot.
$(GDECL)/src/gdextension_interface.h:
	cd $(GDECL)/src && $(GODOT) --headless --dump-gdextension-interface

$(GDECL)/extension_api.json:
	cd $(GDECL) && $(GODOT) --headless --dump-extension-api-with-docs

godot-api:
	rm -f $(GDECL_API_FILES)
	$(MAKE) $(GDECL_API_FILES)

clean:
	-rm -f application.a

.PHONY: all godot-api clean
